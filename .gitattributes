# Ensure LF line endings for files used inside Docker containers.
# Windows git (core.autocrlf=true) would otherwise checkout CRLF,
# causing shell scripts and config files to break at runtime.
*.sh        text eol=lf
*.py        text eol=lf
*.go        text eol=lf
*.mod       text eol=lf
*.sum       text eol=lf
*.conf      text eol=lf
*.cnf       text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.json      text eol=lf
*.ts        text eol=lf
*.tsx       text eol=lf
*.js        text eol=lf
*.jsx       text eol=lf
*.css       text eol=lf
*.html      text eol=lf
*.sql       text eol=lf
*.md        text eol=lf
.env*       text eol=lf
Dockerfile* text eol=lf
